---
import Layout from "../layouts/MainLayout.astro";
import Card from "../components/Card.astro";
import Icon from "../components/Icon.astro";
import Spotify from "../icons/spotify";
import { Calendar } from "@lucide/astro";
import showsData from "../content/shows.json";
import contentData from "../content/index-content.json";
import songsData from "../content/songs.json";

const today = new Date();
const upcomingShows = showsData
  .filter((show) => new Date(show.date) >= today)
  .sort((a, b) => new Date(a.date).valueOf() - new Date(b.date).valueOf());
const nextShow = upcomingShows[0];

const latestSong = [...songsData].sort(
  (a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf(),
)[0];

function formatDate(dateStr: string): string {
  const date = new Date(dateStr);
  return date.toLocaleDateString("de-DE", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
  });
}
---

<Layout title="Fading Hills - Die Alternative Rock Band">
  <div class="relative h-screen w-full overflow-hidden">
    <video
      class="absolute top-0 left-0 w-full h-full object-cover"
      src="/fading-hills-loop.mp4"
      autoplay
      loop
      muted
      playsinline></video>

    <div class="absolute inset-0 bg-black/50"></div>

    <div
      class="relative z-10 w-full max-w-[500px] mx-auto px-5 min-h-screen flex flex-col items-center justify-center gap-4"
    >
      <div class="flex flex-col items-center gap-2">
        <img src="/logo.svg" alt="Logo" class="h-16" />
        <p class="text-xl font-normal text-white">Alternative Rock Band</p>
      </div>

      <div class="w-full space-y-4">
        {
          nextShow && (
            <Card href={nextShow.link}>
              <Calendar size={20} />
              Next: {nextShow.title} - {formatDate(nextShow.date)}
            </Card>
          )
        }
        <Card href={latestSong.spotify}>
          <Spotify />
          {latestSong.title} - Out now
        </Card>
        {
          contentData.cards.map((card) => (
            <Card href={card.href}>
              <Icon name={card.icon} size={20} />
              {card.label}
            </Card>
          ))
        }
      </div>

      <div class="flex space-x-4 *:*:w-7 *:*:h-7">
        {
          contentData.socials.map((social) => (
            <a href={social.href}>
              <Icon name={social.icon} />
            </a>
          ))
        }
      </div>
      <a href="/imprint" class="text-sm mt-3 hover:text-white">Impressum</a>
    </div>
  </div>
</Layout>

<style>
  .bg-image {
    background-image: url("/background.png");
    background-size: cover;
    background-position: center;
  }

  @media screen and (max-width: 768px) {
    .bg-image {
      background-image: url("/bg-mobile.png");
    }
  }
</style>

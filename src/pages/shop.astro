---
import { Image } from 'astro:assets';
import Layout from '../layouts/MainLayout.astro';
import { Link } from 'astro-link';
import { ArrowLeft } from "@lucide/astro";

import wristband from '../../public/shop/wristband.jpg'
import shirtNew from '../../public/shop/tshirt-hfoe.jpg'
import shirtOld from '../../public/shop/tshirts.jpg'
---

<Layout title="Shop | Fading Hills">
    <main class="max-w-5xl mx-auto mb-10">

        <div class="w-full flex justify-center mt-12">
            <Link href="/" class="text-muted-foreground flex items-center gap-2 text-base hover:text-white hover:underline">
                <ArrowLeft size={20}/>
                Zurück zur Startseite
            </Link>
        </div>

        <h1 class="tracking-tight text-center mt-8">Shop</h1>

        <div class="flex flex-col sm:flex-row flex-wrap justify-center items-start gap-10 mt-4">
            <div class="flex flex-col items-center">
                <Image src={wristband} alt="Fading Hills Armband" width={400} class="rounded-xl" />
                <p class="mt-2 text-center">
                    Armband <br />
                    <b>3,-€</b>
                </p>
            </div>
            <div class="flex flex-col items-center">
                <Image src={shirtNew} alt="Band Tshirt" width={400} class="rounded-xl" />
                <p class="mt-2 text-center">
                    Band Tshirt <br />
                    <b>24,99€</b>
                </p>
            </div>
            <div class="flex flex-col items-center">
                <Image src={shirtOld} alt="Band Tshirt Let The Monster Starve" width={400} class="rounded-xl" />
                <p class="mt-2 text-center">
                    Band Tshirt "Let The Monster Starve" <br />
                    <b>24,99€</b>
                </p>
            </div>
        </div>

        <p class="text-center mt-5">
            Bei Interesse, wende dich gerne an ein Bandmitglied, <br />
            oder schreibe uns eine Direktnachricht.
        </p>

    </main>
</Layout>